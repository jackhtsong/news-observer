# Paste values into .env (gitignored). Leave a line blank to skip that integration.
# GitHub Actions stores these as the secrets NEON_CONNECTION_STRING and GEMINI_API (see
# .github/workflows/daily-ingest.yml). On Vercel, the API project needs DATABASE_URL only.

# DATABASE_URL: the Neon connection string (Neon console → Connect → "Pooled connection" off).
# Empty means the API serves the bundled sample events in data/fixtures/.
DATABASE_URL=

# GOOGLE_API_KEY: Gemini key from https://aistudio.google.com/apikey. Used by the daily jobs
# (news enrichment and story linking), never by the website.
GOOGLE_API_KEY=

# Optional: ACLED conflict data, when you have an approved myACLED account.
ACLED_ACCESS_TOKEN=
